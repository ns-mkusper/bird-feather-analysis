# Copy to .env on the machine you run the cluster scripts or notebooks from.
# run_cluster.sh copies it to every node.

# --- Cluster layout
FEATHER_HEAD_HOST=head.example.lan
# Every node that runs a worker, head included (comma-separated)
FEATHER_CLUSTER_HOSTS=head.example.lan,worker1.example.lan,worker2.example.lan
FEATHER_SSH_USER=feather
# Optional dedicated key; empty uses ssh's defaults (agent, ~/.ssh/id_*)
FEATHER_SSH_KEY=
# Repo location on the nodes
FEATHER_REMOTE_REPO_DIR=~/bird-feather-analysis

# --- Broker (Redis on the head; a password here is applied by `pixi run redis`)
BROKER_URL=redis://:change-me@head.example.lan:6379/0
RESULT_BACKEND=redis://:change-me@head.example.lan:6379/1

# --- Pipeline
# sam3 (needs sam3.pt in the repo root, gated: huggingface.co/facebook/sam3) or dino_sam2
FEATHER_SEGMENTER=sam3
# Loads the VLM on each worker (label table, per-feather checks, missed-feather inventory)
FEATHER_ENABLE_VLM=1
FEATHER_VLM_MODEL=mlx-community/Qwen3.8-27B-4bit
# OpenAI-compatible VLM servers for the label table (`pixi run vlm-server`)
FEATHER_VLM_ENDPOINTS=http://head.example.lan:8790
# Specimen label table in cluster runs (read before segmentation, independent of it)
FEATHER_ENABLE_LABELS=1
# Model for labels on workers: auto/local = the worker's loaded MLX model when available,
# server = always FEATHER_VLM_ENDPOINTS
FEATHER_LABEL_VLM=auto
